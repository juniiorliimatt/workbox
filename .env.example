# Copie pra .env (gitignored) e ajuste o que precisar. Todo valor aqui já é o default
# usado se a variável não existir — .env só é necessário pra sobrescrever algo.

# Porta do Postgres exposta no host (dentro da rede docker os serviços sempre falam
# com "postgres:5432", isso aqui é só o mapeamento pro host).
POSTGRES_PORT=7050

# Host do Postgres visto pelos backends — só muda se apontar pra um Postgres fora do
# compose (ex.: gerenciado). Dentro do compose, sempre "postgres" (nome do serviço).
DB_HOST=postgres

# Profile Spring ativo nos dois backends (dev|prod|test).
SPRING_PROFILE=dev

# Segredo HS256 compartilhado entre workbox-api (emite JWT) e budget-service (valida) —
# têm que ser idênticos nos dois. Sem isso, cai no default de application.properties
# (só serve pra estudo local, nunca use isso fora da sua máquina). Fica obsoleto assim
# que o budget-service migrar pra introspecção (abaixo) — ver AGENTS.md.
JWT_SECRET=MyS3cur3P@ssw0rd12345!ThisIs32Bytes!

# Client credentials que o budget-service (ou outro resource server futuro) usa, via
# HTTP Basic, pra chamar POST /api/v1/auth/introspect no workbox-api — valida tokens sem
# nunca conhecer JWT_SECRET. Precisam bater com uma linha ativa na tabela
# workbox.api_clients do workbox-api (fonte da verdade é o banco, não uma env var lá —
# ver workbox-api/src/main/resources/db/changelog/v0.0.2/create/260906_0000_create_table_api_clients.sql).
# Os defaults abaixo já batem com a seed de dev.
INTROSPECTION_CLIENT_ID=budget-service
INTROSPECTION_CLIENT_SECRET=MyS3cur3Cli3ntS3cr3t!Budg3t!

# Idem, client credentials do notes-service (ver
# workbox-api/src/main/resources/db/changelog/v0.0.2/create/260916_0000_seed_api_clients_notes_service.sql).
NOTES_INTROSPECTION_CLIENT_ID=notes-service
NOTES_INTROSPECTION_CLIENT_SECRET=MyS3cur3Cli3ntS3cr3t!N0tes!

# Idem, client credentials do forza-telemetry-service (ver
# workbox-api/src/main/resources/db/changelog/v0.0.2/create/261003_0000_seed_api_clients_forza_telemetry_service.sql).
FORZA_INTROSPECTION_CLIENT_ID=forza-telemetry-service
FORZA_INTROSPECTION_CLIENT_SECRET=MyS3cur3Cli3ntS3cr3t!F0rza!

# Idem, client credentials do backup-service (ver
# workbox-api/src/main/resources/db/changelog/v0.0.2/create/261004_0004_seed_api_clients_backup_service.sql).
BACKUP_INTROSPECTION_CLIENT_ID=backup-service
BACKUP_INTROSPECTION_CLIENT_SECRET=MyS3cur3Cli3ntS3cr3t!B4ckup!

# Idem, client credentials do moto-service (ver
# workbox-api/src/main/resources/db/changelog/v0.0.2/create/261006_0001_seed_api_clients_moto_service.sql).
MOTO_INTROSPECTION_CLIENT_ID=moto-service
MOTO_INTROSPECTION_CLIENT_SECRET=MyS3cur3Cli3ntS3cr3t!M0t0!

# SMTP real pra envio de e-mail de recuperação de senha (POST /api/v1/auth/forgot-password)
# — opcional: sem isso, o endpoint continua respondendo normalmente, só que o e-mail não
# sai de verdade (fica só logado, ver MailService). Exemplo com Gmail: precisa de
# verificação em duas etapas ativa na conta e uma "senha de app" gerada em
# https://myaccount.google.com/apppasswords (não é a senha normal da conta).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=senha-de-app-de-16-caracteres-sem-espacos
MAIL_FROM=seu-email@gmail.com

# Porta do front (workbox-app/nginx) exposta no host.
FRONT_PORT=7053

# Portas dos backends expostas no host — pra testar direto (Postman, curl, etc.) sem
# passar pelo proxy do front.
WORKBOX_API_PORT=7051
BUDGET_SERVICE_PORT=7052
NOTES_SERVICE_PORT=7055
FORZA_SERVICE_PORT=7057
BACKUP_SERVICE_PORT=7058

# Caminho ABSOLUTO no host da pasta ./backups, exibido na tela de backup pra você achar o arquivo.
# Em branco: o scripts/up-all.sh usa <raiz do projeto>/backups; com `docker compose up` direto, a
# tela mostra o caminho de dentro do container (/backups).
BACKUP_HOST_DIR=

# Porta UDP exposta no host pra o Data Out do Forza (Xbox -> IP deste PC). Evite 5200-5300:
# o Forza Horizon usa essa faixa nos próprios sockets. Libere UDP de entrada no firewall.
FORZA_UDP_PORT=5310
# IP da máquina na rede local, exibido na tela "Ao vivo" do front como o endereço do Data Out.
# Em branco: o scripts/up-all.sh detecta sozinho (rota padrão); com `docker compose up` direto,
# o front cai no host do navegador. Defina se a máquina tiver vários IPs (separe por vírgula).
FORZA_HOST_IP=

# Porta do MongoDB exposta no host (dentro da rede docker os serviços sempre falam
# com "mongo:27017", isso aqui é só o mapeamento pro host — ex.: pra abrir no
# MongoDB Compass local).
MONGO_PORT=7054

# Host do MongoDB visto pelos backends — só muda se apontar pra um Mongo fora do
# compose. Dentro do compose, sempre "mongo" (nome do serviço).
MONGO_HOST=mongo

# Credenciais do usuário root do Mongo (MONGO_INITDB_ROOT_USERNAME/PASSWORD — só têm
# efeito em volume vazio; se o volume .mongodata/ já existir, crie o usuário manualmente
# via mongosh antes de mudar essas variáveis, ver notes-service/README.md).
MONGO_USER=root
MONGO_PASSWORD=MyS3cur3M0ngoPassw0rd2026!

# Porta do Redis exposta no host (dentro da rede docker o workbox-api sempre fala com
# "redis:6379", isso aqui é só o mapeamento pro host — ex.: pra abrir no RedisInsight
# local). Guarda só refresh tokens (TTL nativo) — ver workbox-api/README.md.
REDIS_PORT=7056

# Host do Redis visto pelo workbox-api — só muda se apontar pra um Redis fora do
# compose. Dentro do compose, sempre "redis" (nome do serviço).
REDIS_HOST=redis

# Senha do Redis (--requirepass) — sem isso, o container fica sem autenticação nenhuma.
# Precisa bater entre o serviço redis e o workbox-api (mesma variável nos dois).
REDIS_PASSWORD=MyS3cur3R3disP@ssw0rd2026!
