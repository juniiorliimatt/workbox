# Copie pra .env.prod (gitignored) e preencha com valores reais antes de:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# Todas as variáveis abaixo são obrigatórias — o compose recusa subir sem elas
# (ver "${VAR:?...}" em docker-compose.prod.yml).

# Senha do superusuário postgres/postgres do container — gere algo forte, não reuse
# a de dev.
POSTGRES_SUPERUSER_PASSWORD=

# Segredo HS256 do workbox-api, o único que assina/valida JWT — os demais serviços validam
# token por introspecção (client credentials abaixo), nunca conhecem este segredo.
# Gere com: openssl rand -base64 32
JWT_SECRET=

# URL do frontend real, usada pelo workbox-api pra montar o redirect do login social e
# links de e-mail (recuperação de senha) — ex.: https://app.seudominio.com
FRONTEND_BASE_URL=

# Domínios reais com registro A apontando pro IP da VPS — o Caddy usa isso pra emitir
# certificado TLS automático (Let's Encrypt) e rotear cada um pro serviço certo.
API_DOMAIN=
APP_DOMAIN=

# Redis (refresh tokens do workbox-api) e MongoDB (notes-service): senha obrigatória.
# Gere com: openssl rand -base64 24
REDIS_PASSWORD=
MONGO_USER=
MONGO_PASSWORD=

# Client credentials de cada resource server em POST /api/v1/auth/introspect — o client_id
# tem que existir ativo em workbox.api_clients com o hash BCrypt (custo 12) deste secret.
# Insira os clientes reais via changeset novo no workbox-api e desative as seeds de dev.
# Gere cada secret com: openssl rand -base64 32
INTROSPECTION_CLIENT_ID=budget-service
INTROSPECTION_CLIENT_SECRET=
NOTES_INTROSPECTION_CLIENT_ID=notes-service
NOTES_INTROSPECTION_CLIENT_SECRET=
FORZA_INTROSPECTION_CLIENT_ID=forza-telemetry-service
FORZA_INTROSPECTION_CLIENT_SECRET=
BACKUP_INTROSPECTION_CLIENT_ID=backup-service
BACKUP_INTROSPECTION_CLIENT_SECRET=
# Senha do role backup_service (pg_read_all_data) no Postgres: troque a do initdb/03-create-backup-role.sql
# (ALTER ROLE backup_service PASSWORD '...') e use a mesma aqui.
BACKUP_PG_PASSWORD=
# (Opcional) Caminho absoluto no host da pasta ./backups, exibido na tela de backup.
# BACKUP_HOST_DIR=

# (Opcional) Porta UDP publicada no host pro Data Out do Forza. Default 5310. Evite
# 5200-5300 e restrinja no firewall ao IP do console.
# FORZA_UDP_PORT=5310
# IP público/LAN do host, mostrado na tela "Ao vivo" como o endereço do Data Out.
# FORZA_HOST_IP=
